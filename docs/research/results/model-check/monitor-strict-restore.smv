-- P1_phi3_quarantined_never_in_context
CTLSPEC AG ((quarantined -> AG (!(in_context))))
-- P2_memory_is_permanent
CTLSPEC AG ((quarantined -> AG (quarantined)))
-- P3_every_question_ends
CTLSPEC AG (AF (done))
-- P4_bounded_generations
CTLSPEC AG (generations_bounded)
-- P5_phi1_no_released_answer_copies_rare_words
CTLSPEC AG (((done & !(withheld)) -> !(rare_copied)))
-- P6_availability_covered_questions_get_an_answer
CTLSPEC AG (((new_question & covered) -> AF ((done & answered))))
-- E1_a_restored_answer_can_still_refuse
CTLSPEC EF ((done & (restored & refusal)))
